CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=storage
# Zero disables the corresponding size, duration, or processing deadline.
MAX_UPLOAD_MB=0
MAX_AUDIO_SECONDS=0
MAX_QUEUED_JOBS=10
JOB_TIMEOUT_SECONDS=0
RENDER_TIMEOUT_SECONDS=0
RETENTION_HOURS=24
FFMPEG_BIN=ffmpeg
# Optional custom checkpoint location; model setup otherwise uses ~/.cache/piano-scribe/piano.pth.
# PIANO_MODEL_PATH=/absolute/path/to/piano.pth
# If MuseScore is not discovered automatically, set the actual executable path.
# MUSESCORE_BIN="/Applications/MuseScore 4.app/Contents/MacOS/mscore"
